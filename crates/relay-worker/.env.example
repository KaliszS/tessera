HOST_SECRET=dev-secret

# Local only: the Worker counts its own requests and SQL rows (rough estimate for the Admin tab).
TESSERA_DEV_USAGE=1

# Optional: usage counters in the Admin tab (Cloudflare GraphQL Analytics).
# Account ID: Cloudflare dashboard -> Workers & Pages -> right sidebar.
# Token: My Profile -> API Tokens -> Create -> permission "Account Analytics: Read".
CF_ACCOUNT_ID=
CF_API_TOKEN=
