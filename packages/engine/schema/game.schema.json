{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string"
    },
    "edition": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "default_locale": {
      "default": "en",
      "type": "string"
    },
    "players": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "modules": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "default": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "catalogs": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "key": {
            "default": "id",
            "type": "string"
          },
          "columns": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "string",
                "int",
                "number",
                "bool",
                "string_list",
                "int_list"
              ]
            }
          },
          "names": {
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "additionalProperties": false
      }
    },
    "tracks": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "initial": {
            "default": 0,
            "type": "number"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "seat": {
      "default": {
        "fields": {},
        "counters": {},
        "zones": {}
      },
      "type": "object",
      "properties": {
        "fields": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "ref",
                  "enum",
                  "number",
                  "text"
                ]
              },
              "catalog": {
                "type": "string"
              },
              "filter": {
                "type": "string",
                "minLength": 1
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        },
        "counters": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "initial": {
                "default": 0,
                "type": "number"
              },
              "module": {
                "type": "string"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "default": 1,
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "zones": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "catalog": {
                "type": "string"
              },
              "capture": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "unique": {
                "default": false,
                "type": "boolean"
              },
              "filter": {
                "type": "string",
                "minLength": 1
              },
              "sequential": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "catalog"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "derived": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "effects": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string"
            },
            "points": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "category",
            "points"
          ],
          "additionalProperties": false
        }
      }
    },
    "scoring": {
      "type": "object",
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "expr": {
                "type": "string",
                "minLength": 1
              },
              "module": {
                "type": "string"
              },
              "manual": {
                "default": false,
                "type": "boolean"
              },
              "color": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        },
        "manual_adjust": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "categories"
      ],
      "additionalProperties": false
    },
    "setup": {
      "type": "object",
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "catalog": {
                "type": "string"
              },
              "filter": {
                "type": "string",
                "minLength": 1
              },
              "copies": {
                "type": "string",
                "minLength": 1
              },
              "pick_random": {
                "type": "string",
                "minLength": 1
              },
              "group_by": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sections"
      ],
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": {
        "catalogs": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "color_by": {
                "type": "string"
              },
              "badges": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "filter_by": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "colors": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "icons": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "cover": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "id",
    "version",
    "players"
  ],
  "additionalProperties": false
}
